```{=html}
<% if (items[0]) { %>
<div class="archive list research-listing">
<% for (const item of items) { %>
  <%
    const hasDate = !!item.date;
    const hasAuthor = !!item.author;
    const hasVenue = !!(item.citation && item.citation["container-title"]);
    const hasAnyMeta = hasDate || hasAuthor || hasVenue;
    const hasPdf = !!item["pdf-url"];
    const hasExternal = !!(item["external-links"] && item["external-links"].length);
    const hasLinks = hasPdf || hasExternal;
    const calloutText = item["callout-important"];
    const hasCallout = !!(calloutText && String(calloutText).trim().length);
  %>
  <article class="quarto-post research-card<%= hasCallout ? ' is-callout' : '' %>" <%= metadataAttrs(item) %>>
    <% if (item.image) { %>
    <div class="thumbnail">
      <a href="<%- item.path %>" class="no-external" tabindex="-1" aria-hidden="true">
        <img src="<%- item.image %>"
             alt=""
             class="thumbnail-image"
             loading="lazy"
             decoding="async">
      </a>
    </div>
    <% } %>

    <div class="body">
      <header>
        <h4 class="no-anchor listing-title">
          <a href="<%- item.path %>" class="no-external stretched-link">
            <%= item.title %>
          </a>
        </h4>
        <% if (item.subtitle) { %>
        <div class="listing-subtitle"><%= item.subtitle %></div>
        <% } %>
      </header>

      <% if (hasCallout || hasAnyMeta || hasLinks) { %>
      <div class="metadata">
        <% if (hasCallout) { %><span class="callout-pill"><%= calloutText %></span><% } %>
        <% if (hasCallout && hasAnyMeta) { %> <% } %>
        <% if (hasDate) { %><span class="meta-date"><%= item.date %></span><% } %>
        <% if (hasDate && (hasAuthor || hasVenue)) { %> &middot; <% } %>
        <% if (hasAuthor) { %><span class="meta-author"><%= item.author %></span><% } %>
        <% if (hasAuthor && hasVenue) { %> &middot; <% } %>
        <% if (hasVenue) { %><span class="meta-venue"><em><%= item.citation["container-title"] %></em></span><% } %>

        <% if (hasLinks) { %>
        <span class="research-links" aria-label="Related links">
          <% if (hasPdf) { %>
          <a href="<%= item['pdf-url'] %>"
             target="_blank"
             rel="noopener noreferrer"
             class="research-link-btn"
             aria-label="<%= item.title %> (PDF)">
            <i class="bi bi-file-pdf" aria-hidden="true"></i><span>PDF</span>
          </a>
          <% } %>
          <% if (hasExternal) { %>
            <% for (const link of item["external-links"]) { %>
            <a href="<%= link.url %>"
               target="_blank"
               rel="noopener noreferrer"
               class="research-link-btn"
               aria-label="<%= item.title %> &mdash; <%= link.name %>">
              <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span><%= link.name %></span>
            </a>
            <% } %>
          <% } %>
        </span>
        <% } %>
      </div>
      <% } %>
    </div>
  </article>
<% } %>
</div>
<% } else { %>
<p class="research-empty">No content yet.</p>
<% } %>
```